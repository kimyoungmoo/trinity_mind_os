{
    "$schema": "http://json-schema.org/draft-07/schema#",
    "$id": "https://registry.trinity.os/schemas/recipe/v1.0.0",
    "title": "Trinity Recipe Specification",
    "description": "SR₀-approved reproducible execution contract",
    "type": "object",
    "definitions": {
        "Meta": {
            "type": "object",
            "required": [
                "recipe_id",
                "title",
                "version",
                "status"
            ],
            "properties": {
                "recipe_id": {
                    "type": "string",
                    "pattern": "^[a-z0-9-_]{3,50}$",
                    "examples": [
                        "nextjs-page-build",
                        "rag-upload-to-spec"
                    ]
                },
                "title": {
                    "type": "string",
                    "minLength": 5,
                    "maxLength": 100
                },
                "version": {
                    "type": "string",
                    "pattern": "^\\d+\\.\\d+\\.\\d+$",
                    "examples": [
                        "1.0.0",
                        "2.1.3"
                    ]
                },
                "status": {
                    "type": "string",
                    "enum": [
                        "draft",
                        "sr0_pending",
                        "approved",
                        "published",
                        "deprecated"
                    ]
                }
            }
        },
        "Intent": {
            "type": "object",
            "required": [
                "d1_summary",
                "goals"
            ],
            "properties": {
                "d1_summary": {
                    "type": "string",
                    "description": "One-line 'why/what'",
                    "maxLength": 200
                },
                "goals": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "maxLength": 500
                    },
                    "minItems": 1
                },
                "constraints": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "capsule_id": {
                    "type": "string",
                    "pattern": "^capsule_[A-Za-z0-9]{20}$"
                },
                "phase_tags": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "CE+",
                            "CE°",
                            "CE-",
                            "AQ+",
                            "AQ°",
                            "AQ-",
                            "GF+",
                            "GF°",
                            "GF-",
                            "HM+",
                            "HM°",
                            "HM-",
                            "SR₀"
                        ]
                    }
                }
            }
        },
        "Module": {
            "type": "object",
            "required": [
                "name",
                "type"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "type": {
                    "type": "string",
                    "enum": [
                        "service",
                        "agent",
                        "library",
                        "dataset",
                        "pipeline"
                    ]
                },
                "description": {
                    "type": "string"
                },
                "interfaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                }
            }
        },
        "Artifact": {
            "type": "object",
            "required": [
                "name",
                "kind"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "kind": {
                    "type": "string",
                    "enum": [
                        "doc",
                        "spec",
                        "ia",
                        "code",
                        "config",
                        "model",
                        "data"
                    ]
                },
                "path": {
                    "type": "string"
                },
                "content_hash": {
                    "type": "string"
                }
            }
        },
        "SuccessCriterion": {
            "type": "object",
            "required": [
                "kind"
            ],
            "properties": {
                "kind": {
                    "type": "string",
                    "enum": [
                        "tests_pass",
                        "performance",
                        "security",
                        "coverage",
                        "policy_compliance"
                    ]
                },
                "threshold": {},
                "description": {
                    "type": "string"
                }
            }
        },
        "RunnerStep": {
            "type": "object",
            "required": [
                "name",
                "action"
            ],
            "properties": {
                "name": {
                    "type": "string"
                },
                "action": {
                    "type": "string"
                },
                "tool": {
                    "type": "string"
                },
                "timeout_sec": {
                    "type": "integer",
                    "minimum": 1
                },
                "retry": {
                    "type": "integer",
                    "minimum": 0,
                    "maximum": 3
                },
                "require_approval": {
                    "type": "boolean",
                    "default": false
                }
            }
        },
        "InputSpec": {
            "type": "object",
            "patternProperties": {
                "^[a-zA-Z_][a-zA-Z0-9_]*$": {
                    "type": "object",
                    "required": [
                        "type"
                    ],
                    "properties": {
                        "type": {
                            "type": "string",
                            "enum": [
                                "string",
                                "number",
                                "boolean",
                                "file",
                                "array",
                                "object"
                            ]
                        },
                        "required": {
                            "type": "boolean",
                            "default": true
                        },
                        "default": {},
                        "description": {
                            "type": "string"
                        },
                        "validation": {
                            "type": "string"
                        }
                    }
                }
            },
            "additionalProperties": false
        }
    },
    "required": [
        "meta",
        "intent",
        "structure",
        "result",
        "runner",
        "repro"
    ],
    "properties": {
        "meta": {
            "$ref": "#/definitions/Meta"
        },
        "intent": {
            "$ref": "#/definitions/Intent"
        },
        "structure": {
            "type": "object",
            "required": [
                "modules",
                "policies"
            ],
            "properties": {
                "modules": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Module"
                    },
                    "minItems": 1
                },
                "interfaces": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    }
                },
                "policies": {
                    "type": "array",
                    "items": {
                        "type": "string"
                    },
                    "minItems": 1
                }
            }
        },
        "result": {
            "type": "object",
            "required": [
                "artifacts",
                "success_criteria"
            ],
            "properties": {
                "artifacts": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/Artifact"
                    },
                    "minItems": 1
                },
                "success_criteria": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/SuccessCriterion"
                    },
                    "minItems": 1
                }
            }
        },
        "runner": {
            "type": "object",
            "required": [
                "steps"
            ],
            "properties": {
                "build_plan_ref": {
                    "type": "string"
                },
                "steps": {
                    "type": "array",
                    "items": {
                        "$ref": "#/definitions/RunnerStep"
                    },
                    "minItems": 1
                },
                "environment": {
                    "type": "object",
                    "properties": {
                        "runtime": {
                            "type": "string"
                        },
                        "resources": {
                            "type": "object",
                            "properties": {
                                "cpu": {
                                    "type": "string"
                                },
                                "memory": {
                                    "type": "string"
                                },
                                "storage": {
                                    "type": "string"
                                }
                            }
                        }
                    }
                }
            }
        },
        "repro": {
            "type": "object",
            "required": [
                "deterministic",
                "inputs_spec"
            ],
            "properties": {
                "deterministic": {
                    "type": "boolean"
                },
                "inputs_spec": {
                    "$ref": "#/definitions/InputSpec"
                },
                "outputs_hash_spec": {
                    "type": "string"
                }
            }
        },
        "provenance": {
            "type": "object",
            "properties": {
                "source_capsule": {
                    "type": "string"
                },
                "decision_hash": {
                    "type": "string"
                },
                "created_by": {
                    "type": "string"
                },
                "created_at": {
                    "type": "string",
                    "format": "date-time"
                }
            }
        },
        "evidence": {
            "type": "object",
            "required": [
                "required"
            ],
            "properties": {
                "required": {
                    "type": "array",
                    "items": {
                        "type": "string",
                        "enum": [
                            "logs",
                            "metrics",
                            "score",
                            "trace",
                            "reports"
                        ]
                    },
                    "minItems": 1
                },
                "retention_days": {
                    "type": "integer",
                    "minimum": 1
                }
            }
        }
    },
    "additionalProperties": false
}